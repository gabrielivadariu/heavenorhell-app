OPENAI_API_KEY=your-server-only-openai-api-key
# Keep the current model initially; select another supported model after evaluation.
OPENAI_MODEL=gpt-4o-mini
# Generate once: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret
# Server-only RevenueCat secret key, never EXPO_PUBLIC_ or embedded in mobile app.
REVENUECAT_SECRET_API_KEY=your-server-only-revenuecat-key
REVENUECAT_ENTITLEMENT_ID=premium
DAILY_TOKEN_BUDGET=300000
# Persistent disk path for single-process deployments.
USAGE_STORE_PATH=./data/usage.json
# Render has one trusted reverse proxy; local development uses 0.
TRUST_PROXY_HOPS=0

# Enable for internal sandbox validation only after AI credit and durable hosting.
# Keep public release blocked until purchase/restore validation passes.
PAID_CHAT_ENABLED=false
