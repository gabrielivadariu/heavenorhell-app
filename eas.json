{
  "build": {
    "production": {
      "ios": {
        "image": "sdk-57"
      },
      "env": {
        "EXPO_PUBLIC_REVENUECAT_OFFERING_ID": "current",
        "EXPO_PUBLIC_REVENUECAT_PACKAGE_ID": "monthly",
        "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID": "premium"
      },
      "environment": "production",
      "node": "22.23.5",
      "autoIncrement": true
    },
    "native-validation": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "ios": {
        "simulator": true,
        "image": "sdk-57"
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6755818292",
        "appleTeamId": "BY2X3N688N"
      }
    }
  },
  "cli": {
    "promptToConfigurePushNotifications": false,
    "appVersionSource": "remote"
  }
}
