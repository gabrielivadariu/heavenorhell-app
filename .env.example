EXPO_PUBLIC_API_BASE_URL=https://heaven-hell-api-v2.livadariu-ga.workers.dev
EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-public-api-key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=current
EXPO_PUBLIC_REVENUECAT_PACKAGE_ID=monthly

# Optional: pin the store product; otherwise the configured package is used.
# EXPO_PUBLIC_REVENUECAT_PRODUCT_ID=your-app-store-product-id
# Android requires its own RevenueCat public SDK key.
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...
