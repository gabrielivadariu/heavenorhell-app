{
  "name": "heaven-or-hell-app",
  "version": "1.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/with-node.mjs node_modules/expo/bin/cli start",
    "android": "node scripts/with-node.mjs node_modules/expo/bin/cli run:android",
    "ios": "node scripts/with-node.mjs node_modules/expo/bin/cli run:ios",
    "web": "node scripts/with-node.mjs node_modules/expo/bin/cli start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "test:subscriptions": "node --test tests/revenuecat.test.cjs",
    "dev": "node scripts/with-node.mjs scripts/dev.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test:backend": "node --test backend/tests/*.test.js",
    "test": "npm run test:subscriptions && npm run test:conversations && npm run test:backend",
    "test:conversations": "node --test tests/conversations.test.cjs",
    "prebuild": "node scripts/with-node.mjs node_modules/expo/bin/cli prebuild --no-install --no-clean",
    "export:ios": "node scripts/with-node.mjs node_modules/expo/bin/cli export --platform ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~57.0.32",
    "expo-build-properties": "~57.0.23",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.25",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "11.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@types/react": "~19.2.0",
    "eslint": "^8.57.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
